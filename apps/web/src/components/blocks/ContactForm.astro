---
const { b } = Astro.props as { b: any }
const endpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT ?? '/api/contact'
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY
---
<section class="section" id="contact">
  <div class="wrap">
    {b?.heading && <h2>{b.heading}</h2>}
    <form class="card cf" method="post" action={endpoint} data-contact>
      <div class="row">
        <label>Name<input name="name" required autocomplete="name" /></label>
        <label>Email<input name="email" type="email" required autocomplete="email" /></label>
      </div>
      <div class="row">
        <label>Company / website<input name="website" /></label>
        <label>What do you need?
          <select name="service">
            <option value="website" selected={b?.defaultService === 'website'}>New website</option>
            <option value="redesign" selected={b?.defaultService === 'redesign'}>Website redesign</option>
            <option value="store" selected={b?.defaultService === 'store'}>Online store</option>
            <option value="maintenance" selected={b?.defaultService === 'maintenance'}>Maintenance plan</option>
            <option value="it-support" selected={b?.defaultService === 'it-support'}>IT help desk</option>
            <option value="other">Something else</option>
          </select>
        </label>
      </div>
      <label>Budget<input name="budget" placeholder="e.g. A$1,500–3,000" /></label>
      <label>Message<textarea name="message" rows="5"></textarea></label>
      <input type="text" name="company_url" class="visually-hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
      {siteKey && <div class="cf-turnstile" data-sitekey={siteKey}></div>}
      <button class="btn btn-primary" type="submit">Send message →</button>
      <p class="status" role="status" aria-live="polite"></p>
    </form>
  </div>
  {siteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
</section>
<script>
  document.querySelectorAll<HTMLFormElement>('form[data-contact]').forEach((f) => {
    f.addEventListener('submit', async (e) => {
      e.preventDefault()
      const s = f.querySelector('.status')!
      s.textContent = 'Sending…'
      const data = Object.fromEntries(new FormData(f))
      const res = await fetch(f.action, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ ...data, page: location.pathname, referrer: document.referrer }) }).catch(() => null)
      if (res?.ok) { f.reset(); s.textContent = 'Thanks! I’ll reply within 1 business day.' }
      else s.textContent = 'Something went wrong – please email me directly.'
    })
  })
</script>
<style>
  .cf { display: grid; gap: 16px; max-width: 760px; }
  .row { display: grid; gap: 16px; }
  @media (min-width: 640px) { .row { grid-template-columns: 1fr 1fr; } }
  label { display: grid; gap: 6px; font-weight: 600; color: var(--ink); font-size: 0.9rem; }
  input, select, textarea { font: inherit; padding: 12px 14px; border: 1px solid var(--border); border-radius: 10px; background: var(--white); }
</style>
