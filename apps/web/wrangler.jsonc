{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "duy-digital-web",
  "compatibility_date": "2025-08-15",
  // Static site served by Workers Static Assets (no server code).
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  }
  // Production: add a route for duy.digital once DNS is moved, e.g.
  // "routes": [{ "pattern": "duy.digital", "custom_domain": true }]
}
