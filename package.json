{
  "name": "duy-digital",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev:cms": "pnpm --filter @duy/cms dev",
    "dev:web": "pnpm --filter @duy/web dev",
    "build:web": "pnpm --filter @duy/web build",
    "deploy:web": "pnpm --filter @duy/web deploy",
    "deploy:cms": "pnpm --filter @duy/cms deploy",
    "deploy:contact": "pnpm --filter @duy/contact deploy"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}